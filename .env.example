# Environment variables for dmix-writes

# Base URL for metadata, RSS feed, and sitemap (no trailing slash)
SITE_URL=https://your-domain.com

# Optional: self-hosted Umami analytics.
# The script URL must be HTTPS when the blog is HTTPS (browser mixed-content rules).
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Required by docker-compose.analytics.yml
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
